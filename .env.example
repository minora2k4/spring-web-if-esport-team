# Sao chép file này thành ".env" rồi chỉnh giá trị trước khi deploy:
#   cp .env.example .env

# ----- Cơ sở dữ liệu PostgreSQL -----
POSTGRES_DB=ifweb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=doi_mat_khau_nay

# ----- Bảo mật JWT (BẮT BUỘC đổi khi chạy thật, tối thiểu 32 ký tự) -----
APP_JWT_SECRET=hay-thay-bang-chuoi-bi-mat-that-dai-it-nhat-256-bit

# ----- Tên miền / origin công khai của trang web -----
# Dùng cho cấu hình CORS. Local: http://localhost. Thật: https://ten-mien-cua-ban.com
PUBLIC_ORIGIN=http://localhost

# ----- Cổng public mà nginx lắng nghe trên máy host -----
PUBLIC_PORT=80
